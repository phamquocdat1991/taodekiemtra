# Có thể để trống để ứng dụng dùng proxy /supabase trên cùng tên miền.
VITE_SUPABASE_URL=

# Publishable key công khai của dự án Supabase (không dùng service-role key ở frontend).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Chỉ cấu hình GEMINI_API_KEY trong Supabase Edge Function Secrets nếu muốn dùng key chung.
# Giáo viên vẫn có thể nhập key cá nhân; key chỉ giữ trong sessionStorage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
